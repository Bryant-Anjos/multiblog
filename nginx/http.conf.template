# nginx, `http`-level configuration — SHARED BY EVERY BLOG VHOST.
#
# Mirrors the approach the eis-aqui project takes (Phase 45): the per-site part
# is rendered once per *blog* by scripts/render-nginx-sites.sh, and everything
# at `http` level — which nginx allows exactly once — lives here. Repeating a
# `resolver` or two `proxy_cache_path` with the same zone name is a hard
# startup failure, which is the mechanical reason for the split.
#
# This file goes to /etc/nginx/templates/00-http.conf.template, so the nginx
# image's own entrypoint renders it and the `00-` prefix sorts it ahead of the
# vhosts in conf.d.

# Docker's embedded DNS (required by the variable-based `proxy_pass` in
# site.conf.template). Without a resolver, a proxy_pass whose address comes
# from a variable fails at request time. 127.0.0.11 is Docker's built-in
# resolver; `valid=10s` caps how long a name→IP answer is reused.
resolver 127.0.0.11 valid=10s ipv6=off;

# The visitor's real address, behind Cloudflare. The peer connecting to nginx
# is a Cloudflare edge, so without this include every visitor on earth would
# share a handful of buckets. The realip module rewrites `$remote_addr`
# before any other module reads it. See the file itself for the list and the
# reasoning.
include /etc/nginx/cloudflare-ips.conf;

# ── The default server: everything nobody asked for ─────────────────────────
#
# nginx picks a default server per listening port — the first one declared,
# unless a block says `default_server`. Without this pair, a request whose
# Host matches no vhost is answered by whichever blog happens to sort first in
# conf.d. This matters here specifically because briam.cloud will have a
# WILDCARD record: every `*.briam.cloud` resolves to this host, whether or not
# anything is configured for it, so an unknown subdomain must be refused
# rather than half-answered.
#
# `444` closes the connection with no response. On 443 the Host is not even
# readable until TLS is negotiated, so the refusal has to happen during the
# handshake: `ssl_reject_handshake` rejects unknown SNI without needing a
# certificate to present. The ACME/origin challenge is unaffected: certbot
# validates a domain that is in SITES, and those have real vhosts that match
# before this one.
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}