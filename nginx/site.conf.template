# nginx, ONE blog's vhost — rendered ONCE PER BLOG (Site) by
# scripts/render-nginx-sites.sh.
#
# A multiblog installation serves any number of independent blogs, each bound
# to its own hostname (a subdomain such as blog-01.briam.cloud). Every blog is
# served by the SAME two containers — `api` and `web` — and differs only in
# which `Site` the API resolves from the incoming Host. So each vhost is
# identical apart from its `server_name` (and the certificate directory).
#
# Variables supplied by scripts/render-nginx-sites.sh:
#   ${DOMAIN}        the vhost name and the certificate directory
#   ${UPSTREAM_API}  compose network alias of the API container
#   ${UPSTREAM_WEB}  compose network alias of the SSR web container
#   ${SITE_ID}       short id, used for the per-site include

# Plain HTTP: serves the ACME HTTP-01 challenge certbot needs to issue/renew
# the certificate, and redirects every other request to HTTPS.
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN};

    # certbot's directory layout; with the domain proxied by Cloudflare this
    # normally holds a Cloudflare ORIGIN certificate installed by
    # scripts/install-origin-cert.sh. Keeping certbot's layout means the two
    # mechanisms are interchangeable without touching this template.
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include             /etc/nginx/tls.conf;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ── Upstreams as VARIABLES ──────────────────────────────────────────────
    #
    # nginx resolves a LITERAL upstream name once, when it loads the config,
    # and then holds that IP for the life of the configuration. Every deploy
    # recreates the api/web containers and Docker hands the new ones new IPs —
    # so a nginx that is not itself restarted keeps proxying to an address
    # where nothing is listening. An address from a variable is resolved per
    # request through the `resolver` in http.conf.template.
    #
    # With a variable, nginx stops appending the matched location's URI, so
    # `$request_uri` below is not decoration — it preserves the pass-through.
    set $up_api "${UPSTREAM_API}:8080";
    set $up_web "${UPSTREAM_WEB}:3000";

    # Per-site extra configuration, written by scripts/render-nginx-sites.sh
    # (currently unused; the file always exists so this include is stable).
    include /etc/nginx/extra/${SITE_ID}.conf;

    # Every `/api/*` request — the public routes and the admin UI — goes to
    # the API. The multiblog API resolves the blog Site from the Host header,
    # which the browser already sent (each vhost has its own server_name), so
    # we simply forward `Host: $host`.
    location /api/ {
        proxy_pass         http://$up_api$request_uri;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        # Overwritten, not appended: only one value, the visitor's real IP,
        # already rewritten from CF-Connecting-IP by the realip module.
        proxy_set_header   X-Forwarded-For   $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Cookie            $http_cookie;
        proxy_set_header   Connection        "";
    }

    # Everything else — the SSR web server. It renders every route itself
    # (including /sitemap.xml and /robots.txt, which the Next.js app generates
    # per Host). The web reaches the API over its own internal network
    # (API_URL=http://api:8080), not through this proxy.
    location / {
        proxy_pass         http://$up_web$request_uri;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $remote_addr;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Cookie            $http_cookie;
        proxy_set_header   Connection        "";

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    }
}